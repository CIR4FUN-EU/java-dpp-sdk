DPP_REPO_PORT=8080
DPP_REGISTRY_PORT=8081

DPP_IMAGE_REGISTRY=ghcr.io/cir4fun-eu
DPP_IMAGE_TAG=0.6.0
DPP_REPO_IMAGE_NAME=dpp-repo-api
DPP_REGISTRY_IMAGE_NAME=dpp-registry-api

# Demo DPP repo app
DPP_REPO_BACKEND=postgres
DPP_REPO_PROFILE=dpp4fun
DPP_REPO_EVENTS_ENABLED=true

# Demo DPP repo PostgreSQL
DPP_REPO_POSTGRES_PORT=5433
DPP_REPO_POSTGRES_DB=dpp_repo
DPP_REPO_POSTGRES_USER=dpp_repo
DPP_REPO_POSTGRES_PASSWORD=dpp_repo

# Mock registry app
DPP_REGISTRY_BACKEND=postgres

# Mock registry PostgreSQL
DPP_REGISTRY_POSTGRES_PORT=5434
DPP_REGISTRY_POSTGRES_DB=dpp_registry
DPP_REGISTRY_POSTGRES_USER=dpp_registry
DPP_REGISTRY_POSTGRES_PASSWORD=dpp_registry

# Optional host-side datasource values for local JAR/IDE runs in postgres mode.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
