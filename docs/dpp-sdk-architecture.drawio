        <mxCell id="g_model" value="dpp-datamodel&lt;br&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;Canonical EN-oriented model | validation | typed DPP4Fun profile | JSON codecs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#E8F0FE;strokeColor=#4285F4;strokeWidth=2;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#1A4F9E;align=center;spacingTop=12;shadow=1;" parent="1" vertex="1">
